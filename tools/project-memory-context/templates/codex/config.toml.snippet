# PMC — Codex CLI MCP server entry
#
# Schema confirmed 2026-07-29 against @openai/codex. Codex loads this file
# only when the project is trusted (the user accepts Codex's trust prompt
# once on first run). For an MCP entry that loads regardless of trust, the
# same [mcp_servers.agent-memory] block can be added to ~/.codex/config.toml
# manually.
#
# `env` is rendered at install time with MEMORY_DB_PATH and (when present)
# EMBEDDING_CACHE_PATH from the install state. PMC does not write to the
# global ~/.codex/config.toml automatically — that is the user's call.
[mcp_servers.agent-memory]
command = "npx"
args = ["-y", "@aabadin/agent-memory-mcp"]
env = { MEMORY_DB_PATH = "{{MEMORY_DB_PATH}}" }
startup_timeout_sec = 10
tool_timeout_sec = 60
