{
  "mcpServers": {
    "agent-memory": {
      "command": "node",
      "args": [
        "agent-memory-mcp/dist/index.js"
      ],
      "cwd": ".",
      "env": {
        "MEMORY_DB_PATH": ".planning/project-memory-context/memory-db-e5-live",
        "EMBEDDING_MODEL": "Xenova/multilingual-e5-small",
        "EMBEDDING_DIMENSIONS": "384",
        "EMBEDDING_POOLING": "mean",
        "EMBEDDING_WEIGHT_CACHE_PATH": ".planning/project-memory-context/model-weights-e5",
        "EMBEDDING_CACHE_PATH": ".planning/project-memory-context/embedding-cache-e5"
      }
    },
    "pmc-query": {
      "command": "npx",
      "args": [
        "--yes",
        "--package",
        "@aabadin/project-memory-context@0.4.3",
        "pmc-query-server"
      ],
      "env": {
        "PMC_PROJECT_ROOT": "C:\\Users\\aabad\\Documents\\CODE\\ia\\memory-context"
      }
    }
  }
}
